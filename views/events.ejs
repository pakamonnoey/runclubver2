<%- include('partials/head', { title: 'Events - RUN BKK' }) %>

    <section class="events-page">
      <div class="container">
        <div class="page-title">
          <p class="small-title">EVENTS</p>
          <h1>Upcoming Runs</h1>
          <p class="page-lead">กิจกรรมวิ่งที่กำลังจะมาถึงจากคลับในกรุงเทพฯ</p>
        </div>

        <%# method="GET" ค่าค้นหาไปอยู่ใน URL เช่น /events?q=social %>
        <section class="search-section">
          <form class="search-box" action="/events" method="GET">
            <div class="search-field">
              <label class="visually-hidden" for="searchInput">ค้นหากิจกรรมหรือคลับ</label>
              <input
                type="text"
                id="searchInput"
                name="q"
                value="<%= filters.q %>"
                placeholder="ค้นหากิจกรรมหรือคลับ..."
                maxlength="100"
              />
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="locationInput">ค้นหาสถานที่</label>
              <input
                type="text"
                id="locationInput"
                name="location"
                value="<%= filters.location %>"
                placeholder="ค้นหาสถานที่..."
                maxlength="100"
              />
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="typeSelect">ประเภท</label>
              <select id="typeSelect" name="type" class="filter-select">
                <option value="">ทุกประเภท</option>
                <% Object.entries(runTypes).forEach(function ([value, label]) { %>
                <option value="<%= value %>" <%= filters.type === value ? 'selected' : '' %>><%= label %></option>
                <% }); %>
              </select>
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="distanceSelect">ระยะทาง</label>
              <select id="distanceSelect" name="distance" class="filter-select">
                <option value="">ทุกระยะทาง</option>
                <% Object.entries(distances).forEach(function ([value, d]) { %>
                <option value="<%= value %>" <%= filters.distance === value ? 'selected' : '' %>><%= d.label %></option>
                <% }); %>
              </select>
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="sortSelect">เรียงตาม</label>
              <select id="sortSelect" name="sort" class="filter-select">
                <% Object.entries(sorts).forEach(function ([value, s]) { %>
                <option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>>เรียง: <%= s.label %></option>
                <% }); %>
              </select>
            </div>

            <button type="submit" class="search-button">ค้นหา</button>
          </form>

          <p class="search-summary">
            พบ <strong><%= events.length %></strong> กิจกรรม
            <% if (filters.q || filters.location || filters.type || filters.distance) { %>
            · <a href="/events">ล้างตัวกรอง</a>
            <% } %>
          </p>
        </section>

        <div class="event-list">
          <% if (events.length === 0) { %>
          <p class="empty-state">ไม่พบกิจกรรมที่ตรงกับเงื่อนไข</p>
          <% } %>

          <% events.forEach(function (event) { %>
          <%- include('partials/event-row', { event, href: '/events/' + event.id, showClub: true }) %>
          <% }); %>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
