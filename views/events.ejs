<%- include('partials/head', { title: 'Events - RUN BKK' }) %>

    <!-- Events Page -->
    <section class="events-page">
      <div class="container">
        <!-- Page Header -->
        <div class="events-header">
          <h1>Events</h1>
        </div>

        <!-- Page Title -->
        <div class="events-title">
          <p class="small-title">DON'T MISS OUT</p>

          <h2>Upcoming Runs</h2>
        </div>

        <!-- Search: method="GET" → ค่าไปอยู่ใน URL เช่น /events?q=social&type=morning
             server (routes/events.js) อ่านจาก req.query แล้วค้นใน DB -->
        <section class="search-section">
          <form class="search-box" action="/events" method="GET">
            <div class="search-field">
              <label class="visually-hidden" for="searchInput">Search events</label>
              <input
                type="text"
                id="searchInput"
                name="q"
                value="<%= filters.q %>"
                placeholder="Search events or clubs..."
                maxlength="100"
              />
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="locationInput">Search location</label>
              <input
                type="text"
                id="locationInput"
                name="location"
                value="<%= filters.location %>"
                placeholder="Search location..."
                maxlength="100"
              />
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="typeSelect">Run type</label>
              <select id="typeSelect" name="type">
                <option value="">All types</option>
                <% Object.entries(runTypes).forEach(function ([value, label]) { %>
                <option value="<%= value %>" <%= filters.type === value ? 'selected' : '' %>><%= label %></option>
                <% }); %>
              </select>
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="distanceSelect">Event distance</label>
              <select id="distanceSelect" name="distance">
                <option value="">All distances</option>
                <% Object.entries(distances).forEach(function ([value, d]) { %>
                <option value="<%= value %>" <%= filters.distance === value ? 'selected' : '' %>><%= d.label %></option>
                <% }); %>
              </select>
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="sortSelect">Sort by</label>
              <select id="sortSelect" name="sort">
                <% Object.entries(sorts).forEach(function ([value, s]) { %>
                <option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>>เรียง: <%= s.label %></option>
                <% }); %>
              </select>
            </div>

            <button type="submit" class="search-button">Search</button>
          </form>

          <p class="search-summary">
            พบ <strong><%= events.length %></strong> กิจกรรม
            <% if (filters.q || filters.location || filters.type || filters.distance) { %>
            · <a href="/events">ล้างตัวกรอง</a>
            <% } %>
          </p>
        </section>

        <!-- Event List -->
        <div class="event-list">
          <% if (events.length === 0) { %>
          <p class="empty-state">ไม่พบกิจกรรมที่ตรงกับเงื่อนไข</p>
          <% } %>

          <% events.forEach(function (event) { %>
          <a href="/events/<%= event.id %>" class="event-list-card">
            <img src="<%= event.image || event.club_image || '/image/about.jpg' %>" alt="<%= event.title %>" />

            <div class="event-date-box">
              <strong><%= fmt.dayNumber(event.start_at) %></strong>
              <span><%= fmt.monthShort(event.start_at) %></span>
            </div>

            <div class="event-list-info">
              <p class="event-type"><%= fmt.runTypeLabel(event.run_type) %> · <%= event.club_name %></p>

              <h3><%= event.title %></h3>

              <p>📍 <%= event.meeting_point %></p>

              <p>🕐 <%= fmt.timeText(event.start_at) %> · 💰 <%= event.fee || 'ฟรี' %>
                <% if (event.saved_count > 0) { %> · ⭐ <%= event.saved_count %> คนสนใจ<% } %>
              </p>
            </div>

            <div class="event-distance"><%= fmt.distanceText(event.distance_km) %></div>
          </a>
          <% }); %>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
