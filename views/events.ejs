<%- include('partials/head', { title: 'Events - RUN BKK' }) %>

    <!-- Events Page -->
    <section class="events-page">
      <div class="container">
        <!-- Page Header -->
        <div class="events-header">
          <h1>Events</h1>
        </div>

        <!-- Page Title -->
        <div class="events-title">
          <p class="small-title">DON'T MISS OUT</p>

          <h2>Upcoming Events</h2>
        </div>

        <!-- Search -->
        <section class="search-section">
          <div class="search-box">
            <div class="search-field">
              <label class="visually-hidden" for="searchInput">Search events</label>
              <input
                type="text"
                id="searchInput"
                placeholder="Search events..."
              />
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="locationInput">Search location</label>
              <input
                type="text"
                id="locationInput"
                placeholder="Search location..."
              />
            </div>

            <div class="search-field">
              <label class="visually-hidden" for="distanceSelect">Event distance</label>
              <select id="distanceSelect">
                <option value="all">All distances</option>
                <option value="3">3 KM</option>
                <option value="5">5 KM</option>
                <option value="10">10 KM</option>
              </select>
            </div>

            <button class="search-button" onclick="searchEvents()">
              Search
            </button>
          </div>
        </section>
    
        <!-- Event List -->
        <div class="event-list">
          <!-- Event 1 -->
          <a
            href="https://www.runlah.com/th/ihg2026"
            target="_blank"
            rel="noopener noreferrer"
            class="event-list-card"
            data-distance="5"
          >
            <img src="/image/event1.webp" alt="IHG RUN FOR GOOD 2026" />

            <div class="event-date-box">
              <strong>20</strong>
              <span>SEP</span>
            </div>

            <div class="event-list-info">
              <p class="event-type">Fun RUN</p>

              <h3>IHG RUN FOR GOOD 2026</h3>

              <p>📍 Rot Fai Park (สวนรถไฟ)</p>

              <p>🕐 06:00 AM</p>
            </div>

            <div class="event-distance">5 KM</div>
          </a>

          <!-- Event 2 -->
          <a
            href="https://race.thai.run/thaiheartfoundation26?utm_source=runclubbangkok&utm_medium=referral&utm_campaign=events_index&utm_content=thairun-thaiheartfoundation26"
            target="_blank"
            rel="noopener noreferrer"
            class="event-list-card"
            data-distance="5,10"
          >
            <img src="/image/event2.png" alt="WORLD HEART DAY FUN RUN 2026" />

            <div class="event-date-box">
              <strong>27</strong>
