            </div>

            <div class="event-list-info">
              <p class="event-type">Fun Run</p>

              <h3>เดิน-วิ่ง วันหัวใจโลก WORLD HEART DAY FUN RUN 2026</h3>

              <p>📍 Rama VIII Bridge (สะพานพระราม8)</p>

              <p>🕐 04:00 AM</p>
            </div>

            <div class="event-distance">5 / 10 KM</div>
          </a>

          <!-- Event 3 -->
          <a
            href="https://www.runlah.com/th/u9dZslLQ"
            target="_blank"
            rel="noopener noreferrer"
            class="event-list-card"
            data-distance="3,5"
          >
            <img
              src="/image/event3.webp"
              alt="SANRIO CHARACTERS HALF MARATHON"
            />

            <div class="event-date-box">
              <strong>27</strong>
              <span>SEP</span>
            </div>

            <div class="event-list-info">
              <p class="event-type">Fun Run</p>

              <h3>SANRIO CHARACTERS HALF MARATHON</h3>

              <p>📍 One Bangkok (วันแบงค็อก)</p>

              <p>🕐 07:00 AM</p>
            </div>

            <div class="event-distance">3 / 5 KM</div>
          </a>

          <!-- Event 4 -->
          <a
            href="https://race.thai.run/sponsorrunbangkok2026?utm_source=runclubbangkok&utm_medium=referral&utm_campaign=events_index&utm_content=thairun-sponsorrunbangkok2026"
            target="_blank"
            rel="noopener noreferrer"
            class="event-list-card"
            data-distance="5"
          >
            <img src="/image/event4.jpeg" alt="SPONSOR RUN BANGKOK 2026" />

            <div class="event-date-box">
              <strong>4</strong>
              <span>OCT</span>
            </div>

            <div class="event-list-info">
              <p class="event-type">HALF MARATHON</p>

              <h3>SPONSOR RUN BANGKOK 2026</h3>

              <p>📍 Rama VIII Bridge (สะพานพระราม8)</p>

              <p>🕐 06:00 AM</p>
            </div>

            <div class="event-distance">5 KM</div>
          </a>

          <!-- Event 5 -->
          <a
            href="https://www.runlah.com/th/Z2Kybfat"
            target="_blank"
            rel="noopener noreferrer"
            class="event-list-card"
            data-distance="3,5"
          >
            <img src="/image/event5.webp" alt="Run to the Rhythm 2026" />

            <div class="event-date-box">
              <strong>18</strong>
              <span>OCT</span>
            </div>

            <div class="event-list-info">
              <p class="event-type">Marathon</p>

              <h3>Run to the Rhythm 2026</h3>

              <p>📍 Suan Luang Rama IX Public Park (สวนหลวง ร.9)</p>

              <p>🕐 07:00 AM</p>
            </div>

            <div class="event-distance">3 / 5 KM</div>
          </a>

