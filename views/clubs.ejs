<%- include('partials/head', { title: 'Running Clubs - RUN BKK' }) %>

    <section class="clubs-page">
      <div class="container">
        <div class="page-title">
          <p class="small-title">RUN TOGETHER</p>
          <h1>Running Clubs</h1>
          <p class="page-lead">Find a running community and meet new people in Bangkok.</p>
        </div>

        <% if (clubs.length === 0) { %>
        <p class="empty-state">ยังไม่มีข้อมูลคลับ</p>
        <% } %>

        <div class="row g-4 align-items-stretch">
          <% clubs.forEach(function (club) { %>
          <div class="col-md-6 col-lg-4">
            <div class="club-card">
              <div class="club-card-head">
                <img class="club-logo" src="<%= fmt.clubImage(club) %>" alt="<%= club.name %>" loading="lazy" />
                <h2><%= club.name %></h2>
              </div>

              <p class="club-description"><%= club.description %></p>

              <div class="club-bottom">
                <ul class="club-meta">
                  <% if (club.location) { %><li><%- include('partials/icon', { name: 'pin' }) %> <%= club.location %></li><% } %>
                  <% if (club.regular_schedule) { %><li><%- include('partials/icon', { name: 'calendar' }) %> <%= club.regular_schedule %></li><% } %>
                  <% if (club.instagram_url) { %>
                  <li><%- include('partials/icon', { name: 'instagram' }) %> <a href="<%= club.instagram_url %>" class="ig-link" target="_blank" rel="noopener noreferrer"><%= fmt.instagramHandle(club.instagram_url) %></a></li>
                  <% } %>
                </ul>

                <a href="/clubs/<%= club.id %>" class="main-button club-button">
                  <% if (club.upcoming_count > 0) { %>ดูกิจกรรมของคลับ (<%= club.upcoming_count %>)<% } else { %>ดูข้อมูลคลับ<% } %>
                </a>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
