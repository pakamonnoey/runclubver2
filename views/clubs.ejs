<%- include('partials/head', { title: 'Running Clubs - RUN BKK' }) %>

    <!-- Clubs Hero -->

    <section class="clubs-hero">
      <div class="container">
        <p class="small-title">RUN TOGETHER</p>

        <h1>Running Clubs</h1>

        <p>Find a running community and meet new people in Bangkok.</p>
      </div>
    </section>

    <!-- Club List -->

    <section class="clubs-section">
      <div class="container">
        <div class="row g-4 align-items-stretch">
          <% if (clubs.length === 0) { %>
          <p class="text-center">ยังไม่มีข้อมูลคลับ</p>
          <% } %>

          <!-- 1 การ์ด ต่อ 1 แถวใน clubs (ข้อมูลมาจาก routes/pages.js) -->
          <% clubs.forEach(function (club) { %>
          <div class="col-md-4">
            <div class="club-card">
              <div class="club-image">
                <img src="<%= club.image || '/image/about.jpg' %>" alt="<%= club.name %>" />
              </div>

              <div class="club-info">
                <h2><%= club.name %></h2>

                <p><%= club.description %></p>

                <div class="club-bottom">
                  <p>📍 <%= club.location %></p>
                  <% if (club.regular_schedule) { %>
                  <p class="club-schedule">📅 <%= club.regular_schedule %></p>
                  <% } %>

                  <a href="/clubs/<%= club.id %>" class="instagram-button club-detail-link">ดูรายละเอียด</a>

                  <% if (club.instagram_url) { %>
                  <a
                    href="<%= club.instagram_url %>"
                    class="instagram-button"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Instagram →
                  </a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
