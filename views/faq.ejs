<%- include('partials/head', { title: 'FAQ | RUN BKK' }) %>

    <!-- FAQ Hero -->
    <section class="faq-hero">
      <div class="container">
        <h1>FAQ</h1>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">
        <div class="accordion" id="faqAccordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#question1"
              >
                What is RUN BKK?
              </button>
            </h2>

            <div
              id="question1"
              class="accordion-collapse collapse show"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body">
                RUN BKK is a website that helps runners discover running events,
                clubs and places to run around Bangkok.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#question2"
              >
                How can I find running events?
              </button>
            </h2>

            <div
              id="question2"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body">
                You can visit the Events page to find upcoming running events in
                Bangkok.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#question3"
              >
                Where can I find running clubs?
              </button>
            </h2>

            <div
              id="question3"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body">
                Visit the Clubs page to discover running communities and clubs
                around Bangkok.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#question4"
              >
                Can beginners join a running club?
              </button>
            </h2>

            <div
              id="question4"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body">
                Yes. Many running clubs welcome runners of different experience
                levels, including beginners.
              </div>
            </div>
          </div>

          <div class="accordion-item">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#question5"
              >
                How can I find places to run?
              </button>
            </h2>

            <div
              id="question5"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body">
                Check the Spots section on the Home page to discover popular
                running areas in Bangkok.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
