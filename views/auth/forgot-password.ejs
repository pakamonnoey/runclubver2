<%- include('../partials/head', { title }) %>

    <section class="auth-section">
      <div class="container">
        <div class="auth-card">
          <p class="small-title">FORGOT PASSWORD</p>
          <h1>ลืมรหัสผ่าน</h1>

          <% if (sent) { %>
          <%# ข้อความเดียวกันทุกกรณี เดาไม่ได้ว่าอีเมลไหนเป็นสมาชิก %>
          <div class="alert alert-success" role="status">
            ถ้า <strong><%= email %></strong> เป็นอีเมลที่สมัครไว้ เราได้ส่งลิงก์ตั้งรหัสผ่านใหม่ไปให้แล้ว
            (ใช้ได้ 30 นาที) — ถ้าไม่เห็นในกล่องจดหมาย ลองดูใน Spam / Junk
          </div>
          <p class="auth-switch"><a href="/login">กลับไปหน้าเข้าสู่ระบบ</a></p>
          <% } else { %>
          <p class="auth-hint">กรอกอีเมลที่ใช้สมัคร เราจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปให้</p>

          <form action="/forgot-password" method="POST" data-validate novalidate>
            <div class="mb-4">
              <label for="email" class="form-label">อีเมล</label>
              <input type="email" id="email" name="email" class="form-control" required maxlength="255" autocomplete="email" />
              <div class="invalid-feedback"></div>
            </div>

            <button type="submit" class="main-button auth-button">ส่งลิงก์ตั้งรหัสผ่านใหม่</button>
          </form>

          <p class="auth-switch">นึกออกแล้ว? <a href="/login">เข้าสู่ระบบ</a></p>
          <% } %>
        </div>
      </div>
    </section>

    <script src="/js/validate.js"></script>

<%- include('../partials/footer') %>
