<%- include('../partials/head', { title }) %>

    <section class="auth-section">
      <div class="container">
        <div class="auth-card">
          <p class="small-title">RESET PASSWORD</p>
          <h1>ตั้งรหัสผ่านใหม่</h1>

          <% if (!valid) { %>
          <div class="alert alert-warning" role="alert">ลิงก์นี้หมดอายุหรือถูกใช้ไปแล้ว</div>
          <p class="auth-switch"><a href="/forgot-password">ขอลิงก์ใหม่</a></p>
          <% } else { %>
          <!-- action ว่าง = ส่งกลับ URL เดิม (/reset-password/<token>) -->
          <form action="" method="POST" data-validate novalidate>
            <div class="mb-3">
              <label for="password" class="form-label">รหัสผ่านใหม่</label>
              <input type="password" id="password" name="password" required minlength="8" data-letter-number
                     class="form-control <%= errors.password ? 'is-invalid' : '' %>" autocomplete="new-password" />
              <div class="form-text">อย่างน้อย 8 ตัว มีทั้งตัวอักษรภาษาอังกฤษและตัวเลข</div>
              <div class="invalid-feedback"><%= errors.password || '' %></div>
            </div>

            <div class="mb-4">
              <label for="confirmPassword" class="form-label">ยืนยันรหัสผ่านใหม่</label>
              <input type="password" id="confirmPassword" name="confirmPassword" required data-match="password"
                     class="form-control <%= errors.confirmPassword ? 'is-invalid' : '' %>" autocomplete="new-password" />
              <div class="invalid-feedback"><%= errors.confirmPassword || '' %></div>
            </div>

            <button type="submit" class="main-button auth-button">บันทึกรหัสผ่านใหม่</button>
          </form>
          <% } %>
        </div>
      </div>
    </section>

    <script src="/js/validate.js"></script>

<%- include('../partials/footer') %>
