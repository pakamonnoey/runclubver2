<%- include('../partials/head', { title }) %>

    <section class="auth-section">
      <div class="container">
        <div class="auth-card">
          <p class="small-title">JOIN THE COMMUNITY</p>
          <h1>Create Account</h1>

          <!-- novalidate: ปิด popup ของ browser แล้วให้ validate.js แสดง error สวยๆ แทน -->
          <form action="/register" method="POST" data-validate novalidate>
            <div class="mb-3">
              <label for="name" class="form-label">ชื่อ</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control <%= errors.name ? 'is-invalid' : '' %>"
                value="<%= values.name || '' %>"
                required
                minlength="2"
                maxlength="100"
                autocomplete="name"
              />
              <div class="invalid-feedback"><%= errors.name || '' %></div>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">อีเมล</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-control <%= errors.email ? 'is-invalid' : '' %>"
                value="<%= values.email || '' %>"
                required
                maxlength="255"
                autocomplete="email"
              />
              <div class="invalid-feedback"><%= errors.email || '' %></div>
            </div>

            <div class="mb-3">
              <label for="password" class="form-label">รหัสผ่าน</label>
              <input
                type="password"
                id="password"
                name="password"
                class="form-control <%= errors.password ? 'is-invalid' : '' %>"
                required
                minlength="8"
                data-letter-number
                autocomplete="new-password"
              />
              <div class="form-text">อย่างน้อย 8 ตัว มีทั้งตัวอักษรภาษาอังกฤษและตัวเลข</div>
              <div class="invalid-feedback"><%= errors.password || '' %></div>
            </div>

            <div class="mb-4">
              <label for="confirmPassword" class="form-label">ยืนยันรหัสผ่าน</label>
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                class="form-control <%= errors.confirmPassword ? 'is-invalid' : '' %>"
                required
                data-match="password"
                autocomplete="new-password"
              />
              <div class="invalid-feedback"><%= errors.confirmPassword || '' %></div>
            </div>

            <button type="submit" class="main-button auth-button">Register</button>
          </form>

          <p class="auth-switch">มีบัญชีอยู่แล้ว? <a href="/login">เข้าสู่ระบบ</a></p>
        </div>
      </div>
    </section>

    <script src="/js/validate.js"></script>

<%- include('../partials/footer') %>
