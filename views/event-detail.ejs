<%- include('partials/head', { title: event.title + ' - RUN BKK' }) %>

    <section class="detail-page">
      <div class="container">
        <a href="<%= back.href %>" class="back-link">← กลับไป <%= back.label %></a>

        <div class="detail-layout">
          <div class="detail-main">
            <div class="detail-image detail-poster">
              <img class="poster-bg" src="<%= fmt.eventImage(event) %>" alt="" aria-hidden="true" />
              <img class="poster-main" src="<%= fmt.eventImage(event) %>" alt="<%= event.title %>" />
            </div>

            <p class="event-type"><%= fmt.runTypeLabel(event.run_type) %></p>
            <h1><%= event.title %></h1>
            <p class="detail-club">
              โดย <a href="/clubs/<%= event.club_id %>"><%= event.club_name %></a>
            </p>

            <% if (event.description) { %>
            <p class="detail-description"><%= event.description %></p>
            <% } %>
          </div>

          <aside class="detail-box">
            <ul class="detail-facts">
              <li><span><%- include('partials/icon', { name: 'calendar' }) %> วันที่</span><strong><%= fmt.thaiDate(event.start_at) %></strong></li>
              <li><span><%- include('partials/icon', { name: 'clock' }) %> เวลา</span><strong><%= fmt.timeText(event.start_at) %></strong></li>
              <li><span><%- include('partials/icon', { name: 'pin' }) %> จุดนัดพบ</span><strong><%= event.meeting_point %></strong></li>
              <% if (event.distance_km !== null) { %>
              <li><span><%- include('partials/icon', { name: 'route' }) %> ระยะทาง</span><strong><%= fmt.distanceText(event.distance_km) %></strong></li>
              <% } %>
              <li><span><%- include('partials/icon', { name: 'coins' }) %> ค่าใช้จ่าย</span><strong><%= event.fee || 'ฟรี' %></strong></li>
              <li><span><%- include('partials/icon', { name: 'star' }) %> คนสนใจ</span><strong><%= event.saved_count %> คน</strong></li>
            </ul>

            <% if (event.status === 'cancelled') { %>
              <p class="detail-status status-cancelled">กิจกรรมนี้ถูกยกเลิก</p>
            <% } else if (isPast) { %>
              <p class="detail-status">กิจกรรมนี้ผ่านไปแล้ว</p>
            <% } else { %>
            <div class="detail-actions">
              <% if (event.external_url) { %>
              <a href="<%= event.external_url %>" class="main-button detail-button" target="_blank" rel="noopener noreferrer">
                สมัครกับผู้จัด ↗
              </a>
              <% } %>

              <% if (isSaved) { %>
              <p class="detail-status status-joined">✓ อยู่ในลิสต์ของคุณแล้ว</p>
              <form action="/events/<%= event.id %>/unsave" method="POST">
                <% if (from) { %><input type="hidden" name="from" value="<%= from %>" /><% } %>
                <button type="submit" class="outline-button detail-button">เอาออกจากลิสต์</button>
              </form>
              <% } else { %>
              <form action="/events/<%= event.id %>/save" method="POST">
                <% if (from) { %><input type="hidden" name="from" value="<%= from %>" /><% } %>
                <button type="submit" class="outline-button detail-button"><%- include('partials/icon', { name: 'star' }) %> สนใจ · เพิ่มลงลิสต์ของฉัน</button>
              </form>
              <% } %>
            </div>
            <% } %>

            <% if (event.source_url) { %>
            <a href="<%= event.source_url %>" class="source-link" target="_blank" rel="noopener noreferrer">ดูโพสต์ต้นทาง ↗</a>
            <% } %>
          </aside>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
