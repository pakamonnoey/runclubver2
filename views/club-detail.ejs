<%- include('partials/head', { title: club.name + ' - RUN BKK' }) %>

    <!-- ใช้ส่วนหัวสีส้มแบบเดียวกับหน้า Clubs -->
    <section class="clubs-hero">
      <div class="container">
        <a href="/clubs" class="back-link back-link-light">← All Clubs</a>
        <p class="small-title">RUNNING CLUB</p>
        <h1><%= club.name %></h1>
        <p>📍 <%= club.location %></p>
      </div>
    </section>

    <section class="clubs-section">
      <div class="container">
        <div class="detail-layout">
          <div class="detail-main">
            <div class="detail-image">
              <img src="<%= club.image || '/image/about.jpg' %>" alt="<%= club.name %>" />
            </div>
            <p class="detail-description"><%= club.description %></p>
            <% if (club.instagram_url) { %>
            <a href="<%= club.instagram_url %>" class="instagram-button" target="_blank" rel="noopener noreferrer">
              Instagram →
            </a>
            <% } %>
          </div>

          <aside class="detail-box">
            <% if (club.regular_schedule) { %>
            <h2 class="detail-box-title">วิ่งประจำ</h2>
            <p class="club-schedule mb-4">📅 <%= club.regular_schedule %></p>
            <% } %>

            <h2 class="detail-box-title">Upcoming Runs</h2>

            <% if (events.length === 0) { %>
            <p class="empty-state">ยังไม่มีกิจกรรมที่กำลังจะมาถึง</p>
            <% } %>

            <% events.forEach(function (event) { %>
            <a href="/events/<%= event.id %>" class="mini-event">
              <div class="event-date-box">
                <strong><%= fmt.dayNumber(event.start_at) %></strong>
                <span><%= fmt.monthShort(event.start_at) %></span>
              </div>
              <div>
                <p class="event-type"><%= fmt.runTypeLabel(event.run_type) %></p>
                <h3><%= event.title %></h3>
                <p>🕐 <%= fmt.timeText(event.start_at) %> · <%= fmt.distanceText(event.distance_km) %></p>
              </div>
            </a>
            <% }); %>

            <!-- updated_at: DB อัปเดตให้อัตโนมัติทุกครั้งที่แก้ข้อมูลคลับ -->
            <p class="data-updated">ข้อมูลอัปเดตล่าสุด <%= fmt.thaiDate(club.updated_at) %></p>
          </aside>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
