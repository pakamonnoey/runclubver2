<%- include('partials/head', { title: club.name + ' - RUN BKK' }) %>

    <section class="detail-page">
      <div class="container">
        <a href="/clubs" class="back-link">← กลับไป All Clubs</a>

        <!-- ส่วนบน: ข้อมูลคลับทั้งหมดรวมในการ์ดเดียว (โลโก้ / ชื่อ / ข้อมูลย่อ / คำอธิบาย) -->
        <div class="club-profile">
          <div class="club-detail-head">
            <img class="club-logo club-logo-lg" src="<%= fmt.clubImage(club) %>" alt="<%= club.name %>" />
            <div>
              <p class="small-title">RUNNING CLUB</p>
              <h1><%= club.name %></h1>
            </div>
          </div>

          <p class="detail-description"><%= club.description %></p>

          <ul class="club-meta club-profile-meta">
            <% if (club.location) { %><li><%- include('partials/icon', { name: 'pin' }) %> <%= club.location %></li><% } %>
            <% if (club.regular_schedule) { %><li><%- include('partials/icon', { name: 'calendar' }) %> วิ่งประจำ: <%= club.regular_schedule %></li><% } %>
            <% if (club.instagram_url) { %>
            <li><%- include('partials/icon', { name: 'instagram' }) %> <a href="<%= club.instagram_url %>" class="ig-link" target="_blank" rel="noopener noreferrer"><%= fmt.instagramHandle(club.instagram_url) %></a></li>
            <% } %>
          </ul>
        </div>

        <!-- ส่วนหลักของหน้า: กิจกรรมที่กำลังจะมาถึงของคลับนี้ (การ์ดแบบเดียวกับหน้า Events) -->
        <h2 class="club-events-title">กิจกรรมที่กำลังจะมาถึง <span>(<%= events.length %>)</span></h2>

        <div class="event-list">
          <% if (events.length === 0) { %>
          <p class="empty-state">
            ยังไม่มีกิจกรรมที่กำลังจะมาถึง
            <% if (club.instagram_url) { %><br />ติดตามประกาศของคลับได้ที่ <a href="<%= club.instagram_url %>" target="_blank" rel="noopener noreferrer"><%= fmt.instagramHandle(club.instagram_url) %></a><% } %>
          </p>
          <% } %>

          <% events.forEach(function (event) { %>
          <!-- ?from=club → หน้ากิจกรรมจะมีลิงก์ย้อนกลับมาที่คลับนี้ -->
          <%- include('partials/event-row', { event, href: '/events/' + event.id + '?from=club', showClub: false }) %>
          <% }); %>
        </div>

        <!-- updated_at: DB อัปเดตให้อัตโนมัติทุกครั้งที่แก้ข้อมูลคลับ -->
        <p class="data-updated">ข้อมูลคลับอัปเดตล่าสุด <%= fmt.thaiDate(club.updated_at) %></p>
      </div>
    </section>

<%- include('partials/footer') %>
