<%- include('partials/head', { title: 'RUN BKK' }) %>

    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-text">
          <h1>
            FIND YOUR RUN<br />
            FIND YOUR PEOPLE.
          </h1>

          <p class="hero-description">
            Discover running events, clubs and places to run around Bangkok.
          </p>

          <a href="/events" class="main-button"> Explore Events → </a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="about-content">
          <div class="about-image">
            <img
              src="/image/about.jpg"
              alt="Runners enjoying a group run in Bangkok"
              loading="lazy"
            />
          </div>

          <div class="about-text">
            <p class="small-title">WHO WE ARE</p>

            <h2>
              Running is better<br />
              together.
            </h2>

            <p>
              RUN BKK is a simple community platform for people who want to
              discover running events, clubs and running spots around Bangkok.
            </p>

            <p>
              ไม่ว่าคุณจะเป็นนักวิ่งมือใหม่ หรือวิ่งเป็นประจำ
              เราช่วยให้คุณหาอีเวนต์และกลุ่มวิ่งที่เหมาะกับตัวเองได้ง่ายขึ้น
            </p>

            <a href="/clubs" class="main-button"> Find Your Crew → </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Upcoming Events Section -->
    <section class="events-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="small-title">DON'T MISS OUT</p>
            <h2>Upcoming Events</h2>
          </div>
        </div>

        <div class="row g-4">
          <!-- Event 1 -->
          <div class="col-md-4">
            <div class="event-card">
              <div class="event-image">
                <img
                  src="/image/event1.webp"
                  alt="IHG RUN FOR GOOD 2026"
                  loading="lazy"
                />

                <div class="event-date">
                  <strong>20</strong>
                  <small>SEP</small>
                </div>
              </div>

              <div class="event-info">
                <p class="event-type">Fun RUN</p>

                <h3>IHG RUN FOR GOOD 2026</h3>

                <p>📍 Rot Fai Park</p>
                <p>🕐 06:00 AM</p>
              </div>
            </div>
          </div>

          <!-- Event 2 -->
          <div class="col-md-4">
            <div class="event-card">
              <div class="event-image">
                <img
                  src="/image/event2.png"
                  alt="WORLD HEART DAY FUN RUN 2026"
                  loading="lazy"
                />

                <div class="event-date">
                  <strong>27</strong>
                  <small>SEP</small>
                </div>
              </div>

              <div class="event-info">
                <p class="event-type">Fun RUN</p>

                <h3>เดิน-วิ่ง วันหัวใจโลก WORLD HEART DAY FUN RUN 2026</h3>

                <p>📍 สะพานพระราม 8</p>
                <p>🕐 04:00 AM</p>
              </div>
            </div>
          </div>

          <!-- Event 3 -->
          <div class="col-md-4">
            <div class="event-card">
              <div class="event-image">
                <img
                  src="/image/event3.webp"
                  alt="SANRIO CHARACTERS HALF MARATHON"
                  loading="lazy"
                />

                <div class="event-date">
                  <strong>27</strong>
                  <small>SEP</small>
                </div>
              </div>

              <div class="event-info">
                <p class="event-type">Fun RUN</p>

                <h3>SANRIO CHARACTERS HALF MARATHON</h3>

                <p>📍 One Bangkok</p>
                <p>🕐 07:00 AM</p>
              </div>
            </div>
          </div>
        </div>
        <a href="/events" class="view-events">All Events</a>
      </div>
    </section>

    <!--Spots -->
    <section class="spots-section" id="spots">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="small-title">RUN AROUND BANGKOK</p>

            <h2>Popular Running Spots</h2>
          </div>
        </div>

        <div class="row g-4">
          <!-- Spot 1 -->
          <div class="col-md-4">
            <div class="spot-card">
              <div class="spot-image">
                <img
                  src="/image/spot_lum.webp"
                  alt="Runners at Lumpini Park"
                  loading="lazy"
                />
              </div>

              <div class="spot-info">
                <p class="spot-area">SILOM / PATHUM WAN</p>

                <h3>Lumpini Park</h3>

                <p>สวนใจกลางกรุงเทพฯ เหมาะสำหรับ วิ่งตอนเช้าและช่วงเย็น</p>
              </div>
            </div>
          </div>

          <!-- Spot 2 -->
          <div class="col-md-4">
            <div class="spot-card">
              <div class="spot-image">
                <img
                  src="/image/spot_ben.jpg"
                  alt="Benjakitti Park"
                  loading="lazy"
                />
              </div>

              <div class="spot-info">
                <p class="spot-area">KHLONG TOEI</p>

                <h3>Benjakitti Park</h3>

                <p>พื้นที่วิ่งขนาดใหญ่ใจกลางเมือง เหมาะสำหรับวิ่งและเดินเล่น</p>
              </div>
            </div>
          </div>

          <!-- Spot 3 -->
          <div class="col-md-4">
            <div class="spot-card">
              <div class="spot-image">
                <img
                  src="/image/spot_chat.jpeg"
                  alt="Chatuchak Park"
                  loading="lazy"
                />
              </div>

              <div class="spot-info">
                <p class="spot-area">CHATUCHAK</p>

                <h3>Chatuchak Park</h3>

                <p>ย่านยอดนิยมสำหรับกลุ่มนักวิ่ง และกิจกรรมในช่วงสุดสัปดาห์</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
