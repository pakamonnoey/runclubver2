<%- include('partials/head', { title: 'RUN BKK' }) %>

    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-text">
          <h1>
            FIND YOUR RUN<br />
            FIND YOUR PEOPLE.
          </h1>

          <p class="hero-description">
            Discover running events, clubs and places to run around Bangkok.
          </p>

          <a href="/events" class="main-button"> Explore Events → </a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="about-content">
          <div class="about-image">
            <img
              src="/image/about.jpg"
              alt="Runners enjoying a group run in Bangkok"
              loading="lazy"
            />
          </div>

          <div class="about-text">
            <p class="small-title">WHO WE ARE</p>

            <h2>
              Running is better<br />
              together.
            </h2>

            <p>
              RUN BKK รวมคลับวิ่งและกิจกรรมวิ่งในกรุงเทพฯ ไว้ในที่เดียว
              ทั้งวิ่งประจำสัปดาห์ของแต่ละคลับ และกิจกรรมพิเศษที่เปิดให้ทุกคนมาร่วม
              เราไม่ใช่เว็บขายบัตรงานวิ่ง แต่เป็นที่ช่วยให้คุณหากลุ่มวิ่งที่ใช่ได้ง่ายขึ้น
            </p>

            <p>
              ข้อมูลกิจกรรมรวบรวมจากช่องทางทางการของแต่ละคลับ เช่น Instagram
              เจอกิจกรรมที่ชอบก็กด "สนใจ" เก็บไว้ในลิสต์ของคุณ
              แล้วสมัครกับผู้จัดหรือไปตามจุดนัดได้เลย ไม่ว่าจะเป็นมือใหม่หรือวิ่งเป็นประจำ
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Running Clubs -->
    <section class="home-clubs-section" id="clubs">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="small-title">FIND YOUR CREW</p>
            <h2>Running Clubs</h2>
          </div>
        </div>

        <div class="club-logos">
          <% clubs.forEach(function (club) { %>
          <img src="<%= club.image %>" alt="<%= club.name %>" title="<%= club.name %>" loading="lazy" />
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Upcoming Events -->
    <section class="events-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="small-title">DON'T MISS OUT</p>
            <h2>Upcoming Events</h2>
          </div>
        </div>

        <% if (events.length === 0) { %>
        <p class="empty-state">ยังไม่มีกิจกรรมที่กำลังจะมาถึง — ติดตามได้เร็วๆ นี้</p>
        <% } %>

        <div class="row g-4">
          <% events.forEach(function (event) { %>
          <div class="col-md-4">
            <a href="/events/<%= event.id %>" class="event-card card-link">
              <!-- รูปเบลอเป็นพื้นหลัง + โปสเตอร์เต็มรูปทับด้านบน -->
              <div class="event-image">
                <img class="poster-bg" src="<%= fmt.eventImage(event) %>" alt="" aria-hidden="true" loading="lazy" />
                <img
                  class="poster-main"
                  src="<%= fmt.eventImage(event) %>"
                  alt="<%= event.title %>"
                  loading="lazy"
                />

                <div class="event-date">
                  <strong><%= fmt.dayNumber(event.start_at) %></strong>
                  <small><%= fmt.monthShort(event.start_at) %></small>
                </div>
              </div>

              <div class="event-info">
                <p class="event-type"><%= fmt.runTypeLabel(event.run_type) %></p>

                <h3><%= event.title %></h3>

                <p><%- include('partials/icon', { name: 'pin' }) %> <%= event.meeting_point %></p>
                <p><%- include('partials/icon', { name: 'clock' }) %> <%= fmt.timeText(event.start_at) %></p>
              </div>
            </a>
          </div>
          <% }); %>
        </div>
        <a href="/events" class="view-events">All Events</a>
      </div>
    </section>

    <!-- Spots -->
    <section class="spots-section" id="spots">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="small-title">RUN AROUND BANGKOK</p>

            <h2>Popular Running Spots</h2>
          </div>
        </div>

        <div class="row g-4">
          <!-- Spot 1 -->
          <div class="col-md-4">
            <div class="spot-card">
              <div class="spot-image">
                <img
                  src="/image/spot_lum.webp"
                  alt="Runners at Lumpini Park"
                  loading="lazy"
                />
              </div>

              <div class="spot-info">
                <p class="spot-area">SILOM / PATHUM WAN</p>

                <h3>Lumpini Park</h3>

                <p>สวนใจกลางกรุงเทพฯ เหมาะสำหรับ วิ่งตอนเช้าและช่วงเย็น</p>
              </div>
            </div>
          </div>

          <!-- Spot 2 -->
          <div class="col-md-4">
            <div class="spot-card">
              <div class="spot-image">
                <img
                  src="/image/spot_ben.jpg"
                  alt="Benjakitti Park"
                  loading="lazy"
                />
              </div>

              <div class="spot-info">
                <p class="spot-area">KHLONG TOEI</p>

                <h3>Benjakitti Park</h3>

                <p>พื้นที่วิ่งขนาดใหญ่ใจกลางเมือง เหมาะสำหรับวิ่งและเดินเล่น</p>
              </div>
            </div>
          </div>

          <!-- Spot 3 -->
          <div class="col-md-4">
            <div class="spot-card">
              <div class="spot-image">
                <img
                  src="/image/spot_chat.jpeg"
                  alt="Chatuchak Park"
                  loading="lazy"
                />
              </div>

              <div class="spot-info">
                <p class="spot-area">CHATUCHAK</p>

                <h3>Chatuchak Park</h3>

                <p>ย่านยอดนิยมสำหรับกลุ่มนักวิ่ง และกิจกรรมในช่วงสุดสัปดาห์</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%# Visitor Counter: visitors มาจาก routes/pages.js (null = นับไม่สำเร็จ ไม่แสดง) %>
    <% if (visitors) { %>
    <section class="visitor-counter">
      <div class="container">
        <p class="small-title">VISITORS</p>
        <div class="visitor-stats">
          <div>
            <strong><%= visitors.today.toLocaleString() %></strong>
            <span>ผู้เข้าชมวันนี้</span>
          </div>
          <div>
            <strong><%= visitors.total.toLocaleString() %></strong>
            <span>ผู้เข้าชมทั้งหมด</span>
          </div>
        </div>
      </div>
    </section>
    <% } %>

<%- include('partials/footer') %>
