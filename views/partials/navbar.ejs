<!-- Navigation -->
<nav class="navbar">
  <div class="container">
    <a href="/" class="logo">RUN<span>BKK</span></a>
    <button
      type="button"
      class="menu-button"
      id="menuButton"
      aria-label="เปิดเมนูนำทาง"
      aria-controls="menu"
      aria-expanded="false"
      onclick="toggleMenu()"
    >
      ☰
    </button>
    <div class="menu" id="menu">
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <a href="/clubs">Clubs</a>
      <a href="/#spots">Spots</a>
      <a href="/#about">About</a>
      <a href="/faq">FAQ</a>

      <!-- locals.currentUser: ใช้ locals. เพื่อไม่ error ถ้าบางหน้าไม่มีตัวแปรนี้ -->
      <% if (locals.currentUser) { %>
      <a href="/my-runs">My Runs</a>
      <a href="/profile" class="menu-user">👋 <%= currentUser.name %></a>
      <form action="/logout" method="POST" class="menu-logout">
        <button type="submit">Logout</button>
      </form>
      <% } else { %>
      <a href="/login" class="menu-login">Login</a>
      <a href="/register" class="menu-register">Register</a>
      <% } %>
    </div>
  </div>
</nav>
