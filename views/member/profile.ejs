<%- include('../partials/head', { title: 'Profile - RUN BKK' }) %>

    <section class="auth-section">
      <div class="container">
        <div class="auth-card">
          <p class="small-title">MY ACCOUNT</p>
          <h1>Profile</h1>

          <ul class="detail-facts mb-4">
            <li><span>อีเมล</span><strong><%= profile.email %></strong></li>
            <li><span>สถานะ</span><strong class="text-capitalize"><%= profile.role %></strong></li>
            <li><span>สมัครเมื่อ</span><strong><%= fmt.thaiDate(profile.created_at) %></strong></li>
          </ul>

          <!-- แก้ชื่อ -->
          <form action="/profile" method="POST" data-validate novalidate>
            <div class="mb-3">
              <label for="name" class="form-label">ชื่อ</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control <%= errors.name ? 'is-invalid' : '' %>"
                value="<%= profile.name %>"
                required
                minlength="2"
                maxlength="100"
              />
              <div class="invalid-feedback"><%= errors.name || '' %></div>
            </div>
            <button type="submit" class="main-button auth-button">บันทึกชื่อ</button>
          </form>

          <hr class="my-4" />

          <!-- เปลี่ยนรหัสผ่าน -->
          <h2 class="form-section-title">เปลี่ยนรหัสผ่าน</h2>
          <form action="/profile/password" method="POST" data-validate novalidate>
            <div class="mb-3">
              <label for="currentPassword" class="form-label">รหัสผ่านปัจจุบัน</label>
              <input
                type="password"
                id="currentPassword"
                name="currentPassword"
                class="form-control <%= errors.currentPassword ? 'is-invalid' : '' %>"
                required
                autocomplete="current-password"
              />
              <div class="invalid-feedback"><%= errors.currentPassword || '' %></div>
            </div>
            <div class="mb-3">
              <label for="newPassword" class="form-label">รหัสผ่านใหม่</label>
              <input
                type="password"
                id="newPassword"
                name="newPassword"
                class="form-control <%= errors.newPassword ? 'is-invalid' : '' %>"
                required
                minlength="8"
                data-letter-number
                autocomplete="new-password"
              />
              <div class="form-text">อย่างน้อย 8 ตัว มีทั้งตัวอักษรภาษาอังกฤษและตัวเลข</div>
              <div class="invalid-feedback"><%= errors.newPassword || '' %></div>
            </div>
            <div class="mb-4">
              <label for="confirmPassword" class="form-label">ยืนยันรหัสผ่านใหม่</label>
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                class="form-control <%= errors.confirmPassword ? 'is-invalid' : '' %>"
                required
                data-match="newPassword"
                autocomplete="new-password"
              />
              <div class="invalid-feedback"><%= errors.confirmPassword || '' %></div>
            </div>
            <button type="submit" class="outline-button auth-button">เปลี่ยนรหัสผ่าน</button>
          </form>

        </div>
      </div>
    </section>

    <script src="/js/validate.js"></script>

<%- include('../partials/footer') %>
