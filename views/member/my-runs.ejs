<%- include('../partials/head', { title: 'My Runs - RUN BKK' }) %>

    <section class="events-page">
      <div class="container">
        <div class="page-title">
          <p class="small-title">MY LIST</p>
          <h1>My Runs</h1>
          <p class="page-lead">กิจกรรมที่คุณกด "สนใจ" เก็บไว้ — การสมัครจริงให้กดลิงก์ของผู้จัดในหน้ากิจกรรม</p>
        </div>

        <!-- กำลังจะมาถึง: เอาออกจากลิสต์ได้ -->
        <div class="events-title">
          <p class="small-title">UPCOMING</p>
          <h2>กิจกรรมที่กำลังจะมาถึง (<%= upcoming.length %>)</h2>
        </div>

        <div class="event-list">
          <% if (upcoming.length === 0) { %>
          <p class="empty-state">ยังไม่มีกิจกรรมในลิสต์ — <a href="/events">ดูกิจกรรมทั้งหมด</a> แล้วกดสนใจ</p>
          <% } %>

          <% upcoming.forEach(function (run) { %>
          <%- include('../partials/event-row', { event: run, href: '/events/' + run.id + '?from=my-runs', showClub: true, removable: true }) %>
          <% }); %>
        </div>

        <!-- ที่ผ่านมา -->
        <% if (past.length > 0) { %>
        <div class="events-title mt-5">
          <p class="small-title">HISTORY</p>
          <h2>กิจกรรมที่ผ่านมา (<%= past.length %>)</h2>
        </div>

        <div class="event-list past-list">
          <% past.forEach(function (run) { %>
          <%- include('../partials/event-row', { event: run, href: '/events/' + run.id + '?from=my-runs', showClub: true }) %>
          <% }); %>
        </div>
        <% } %>
      </div>
    </section>

<%- include('../partials/footer') %>
