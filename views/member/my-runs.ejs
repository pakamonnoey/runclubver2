<%- include('../partials/head', { title: 'My Runs - RUN BKK' }) %>

    <section class="events-page">
      <div class="container">
        <div class="page-title">
          <p class="small-title">MY LIST</p>
          <h1>My Runs</h1>
          <p class="page-lead">กิจกรรมที่คุณกด "สนใจ" เก็บไว้ — การสมัครจริงให้กดลิงก์ของผู้จัดในหน้ากิจกรรม</p>
        </div>

        <!-- กำลังจะมาถึง: เอาออกจากลิสต์ได้ -->
        <div class="events-title">
          <p class="small-title">UPCOMING</p>
          <h2>กิจกรรมที่กำลังจะมาถึง (<%= upcoming.length %>)</h2>
        </div>

        <div class="event-list">
          <% if (upcoming.length === 0) { %>
          <p class="empty-state">ยังไม่มีกิจกรรมในลิสต์ — <a href="/events">ดูกิจกรรมทั้งหมด</a> แล้วกดสนใจ</p>
          <% } %>

          <% upcoming.forEach(function (run) { %>
          <div class="event-list-card">
            <img src="<%= run.image || run.club_image || '/image/about.jpg' %>" alt="<%= run.title %>" />

            <div class="event-date-box">
              <strong><%= fmt.dayNumber(run.start_at) %></strong>
              <span><%= fmt.monthShort(run.start_at) %></span>
            </div>

            <div class="event-list-info">
              <p class="event-type"><%= fmt.runTypeLabel(run.run_type) %> · <%= run.club_name %></p>
              <h3><a href="/events/<%= run.id %>?from=my-runs" class="plain-link"><%= run.title %></a></h3>
              <ul class="event-meta">
                <li><%- include('../partials/icon', { name: 'clock' }) %> <%= fmt.timeText(run.start_at) %></li>
                <li><%- include('../partials/icon', { name: 'pin' }) %> <%= run.meeting_point %></li>
                <% if (run.status === 'cancelled') { %><li class="text-danger">กิจกรรมถูกยกเลิก</li><% } %>
              </ul>
            </div>

            <form action="/events/<%= run.id %>/unsave" method="POST"
                  onsubmit="return confirm('เอากิจกรรมนี้ออกจากลิสต์?')">
              <!-- from = บอก server ให้พากลับมาหน้า My Runs หลังกด -->
              <input type="hidden" name="from" value="my-runs" />
              <button type="submit" class="outline-button">เอาออก</button>
            </form>
          </div>
          <% }); %>
        </div>

        <!-- ที่ผ่านมา -->
        <% if (past.length > 0) { %>
        <div class="events-title mt-5">
          <p class="small-title">HISTORY</p>
          <h2>กิจกรรมที่ผ่านมา (<%= past.length %>)</h2>
        </div>

        <div class="event-list past-list">
          <% past.forEach(function (run) { %>
          <a href="/events/<%= run.id %>?from=my-runs" class="event-list-card">
            <img src="<%= run.image || run.club_image || '/image/about.jpg' %>" alt="<%= run.title %>" />
            <div class="event-date-box">
              <strong><%= fmt.dayNumber(run.start_at) %></strong>
              <span><%= fmt.monthShort(run.start_at) %></span>
            </div>
            <div class="event-list-info">
              <p class="event-type"><%= fmt.runTypeLabel(run.run_type) %> · <%= run.club_name %></p>
              <h3><%= run.title %></h3>
              <ul class="event-meta">
                <li><%- include('../partials/icon', { name: 'pin' }) %> <%= run.meeting_point %></li>
              </ul>
            </div>
            <div class="event-distance"><%= fmt.distanceText(run.distance_km) %></div>
          </a>
          <% }); %>
        </div>
        <% } %>
      </div>
    </section>

<%- include('../partials/footer') %>
