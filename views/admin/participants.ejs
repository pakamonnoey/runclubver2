<%- include('../partials/head', { title: 'Interested Members - RUN BKK' }) %>

    <section class="dashboard-page">
      <div class="container">
        <a href="/admin/events" class="back-link">← Events</a>
        <div class="dashboard-header">
          <div>
            <p class="small-title"><%= event.club_name %></p>
            <h1><%= event.title %></h1>
            <p class="text-muted mb-0">
              <%= fmt.thaiDate(event.start_at) %> · <%= fmt.timeText(event.start_at) %> ·
              <span class="status-badge status-<%= event.status %>"><%= event.status %></span>
            </p>
          </div>
        </div>

        <div class="dashboard-card">
          <h2 class="form-section-title">
            สมาชิกที่สนใจ (บันทึกลงลิสต์) <%= participants.length %> คน
          </h2>

          <% if (event.external_url) { %>
          <p class="text-muted">การสมัครจริงอยู่ที่ลิงก์ของผู้จัด — รายชื่อนี้คือคนที่กดบันทึกไว้ในเว็บเรา</p>
          <% } %>

          <% if (participants.length === 0) { %>
          <p class="empty-state">ยังไม่มีใครบันทึกกิจกรรมนี้</p>
          <% } else { %>
          <div class="table-responsive">
            <table class="table dashboard-table">
              <thead><tr><th>#</th><th>ชื่อ</th><th>อีเมล</th><th>บันทึกเมื่อ</th></tr></thead>
              <tbody>
                <% participants.forEach(function (p, i) { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><%= p.name %></td>
                  <td><%= p.email %></td>
                  <td><%= fmt.shortDateTime(p.saved_at) %></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </section>

<%- include('../partials/footer') %>
