<%- include('../partials/head', { title: 'Manage Clubs - RUN BKK' }) %>

    <section class="dashboard-page">
      <div class="container">
        <div class="dashboard-header">
          <div><p class="small-title">ADMIN</p><h1>Clubs</h1></div>
          <a href="/admin/clubs/new" class="main-button">+ เพิ่มคลับ</a>
        </div>
        <%- include('../partials/admin-nav', { active: 'clubs' }) %>

        <div class="dashboard-card">
          <div class="table-responsive">
            <!-- data-label = ชื่อคอลัมน์ บนมือถือ CSS แสดงแต่ละแถวเป็นการ์ด และใช้ data-label เป็นหัวข้อของแต่ละช่อง -->
            <table class="table dashboard-table">
              <thead><tr><th>ชื่อคลับ</th><th>กิจกรรม</th><th>สถานะ</th><th></th></tr></thead>
              <tbody>
                <% clubs.forEach(function (c) { %>
                <tr>
                  <td class="cell-title">
                    <% if (c.status === 'published') { %><a href="/clubs/<%= c.id %>" class="plain-link"><%= c.name %></a>
                    <% } else { %><%= c.name %><% } %>
                  </td>
                  <td data-label="กิจกรรม"><%= c.event_count %></td>
                  <td data-label="สถานะ"><span class="status-badge status-<%= c.status %>"><%= c.status %></span></td>
                  <td class="cell-actions">
                    <!-- flex อยู่ใน div ไม่ใส่ที่ td ตรงๆ (td ที่เป็น flex จะหลุดจากตาราง เส้นแถวเลยไม่ตรงกัน) -->
                    <div class="dashboard-actions">
                      <a href="/admin/clubs/<%= c.id %>/edit">แก้ไข</a>
                      <a href="/admin/events/new?club=<%= c.id %>">+ กิจกรรม</a>
                      <form action="/admin/clubs/<%= c.id %>/delete" method="POST"
                            onsubmit="return confirm('ลบคลับนี้? กิจกรรม <%= c.event_count %> รายการและรายการที่สมาชิกบันทึกไว้จะถูกลบด้วย')">
                        <button type="submit" class="link-danger-button">ลบ</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

<%- include('../partials/footer') %>
