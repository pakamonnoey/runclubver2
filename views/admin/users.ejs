<%- include('../partials/head', { title: 'Manage Users - RUN BKK' }) %>

    <section class="dashboard-page">
      <div class="container">
        <div class="dashboard-header">
          <div><p class="small-title">ADMIN</p><h1>Users</h1></div>
        </div>
        <%- include('../partials/admin-nav', { active: 'users' }) %>

        <div class="dashboard-card">
          <div class="table-responsive">
            <%# data-label ใช้เป็นหัวข้อตอนแสดงเป็นการ์ดบนมือถือ %>
            <table class="table dashboard-table">
              <thead>
                <tr><th>ชื่อ</th><th>อีเมล</th><th>สมัครเมื่อ</th><th>กิจกรรมในลิสต์</th><th>Role</th><th></th></tr>
              </thead>
              <tbody>
                <% users.forEach(function (u) { const isMe = u.id === currentUser.id; %>
                <tr>
                  <td class="cell-title"><%= u.name %><%= isMe ? ' (คุณ)' : '' %></td>
                  <td data-label="อีเมล"><%= u.email %></td>
                  <td data-label="สมัครเมื่อ"><%= fmt.shortDateTime(u.created_at) %></td>
                  <td data-label="กิจกรรมในลิสต์"><%= u.run_count %></td>
                  <td data-label="Role">
                    <% if (isMe) { %>
                    <span class="status-badge status-published"><%= u.role %></span>
                    <% } else { %>
                    <form action="/admin/users/<%= u.id %>/role" method="POST" class="inline-form">
                      <select name="role" class="form-select form-select-sm" aria-label="role">
                        <% ['member', 'admin'].forEach(function (role) { %>
                        <option value="<%= role %>" <%= u.role === role ? 'selected' : '' %>><%= role %></option>
                        <% }); %>
                      </select>
                      <button type="submit" class="outline-button btn-sm-custom">บันทึก</button>
                    </form>
                    <% } %>
                  </td>
                  <td class="cell-actions">
                    <% if (!isMe) { %>
                    <form action="/admin/users/<%= u.id %>/delete" method="POST"
                          onsubmit="return confirm('ลบผู้ใช้คนนี้? ลิสต์กิจกรรมของผู้ใช้นี้จะถูกลบด้วย')">
                      <%# ไม่ใส่ชื่อ/อีเมลใน confirm() เพราะ escape แบบ HTML กัน XSS ใน JS ไม่ได้ %>
                      <button type="submit" class="link-danger-button">ลบ</button>
                    </form>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

<%- include('../partials/footer') %>
