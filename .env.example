# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
PORT=3000

# Database (MariaDB/MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=runbkk_app
DB_PASSWORD=change_me
DB_NAME=runbkk

# Session — ใช้ค่าสุ่มยาวๆ เช่นจากคำสั่ง: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string

# ตอน deploy จริงให้ตั้ง NODE_ENV=production (cookie จะส่งผ่าน HTTPS เท่านั้น)
# NODE_ENV=production
# ถ้า DB บน cloud บังคับ SSL
# DB_SSL=true

# ลืมรหัสผ่าน (ส่งอีเมลผ่าน Brevo — สมัครฟรีที่ brevo.com)
# ไม่ใส่ BREVO_API_KEY ตอนพัฒนาในเครื่อง → ลิงก์ตั้งรหัสใหม่จะแสดงใน Terminal แทน
# BREVO_API_KEY=
# MAIL_FROM=อีเมลผู้ส่งที่ยืนยันกับ Brevo แล้ว
# ที่อยู่เว็บสำหรับใส่ในลิงก์ (เว็บจริงใส่ URL ของ Render)
# APP_URL=http://localhost:3000
